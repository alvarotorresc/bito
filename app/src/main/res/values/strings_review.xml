<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The E1 daily review, E2 sealed/perfect-day sheets and the celebration setting (T8) —
        M9 draft copy — pending architect validation (docs/07). Habi's own voiced lines for these
        contexts live in strings_habi.xml (habi_review_*, habi_sealed_*, habi_perfect_*), not
        here — this file holds the review screen's plain UI strings.
    -->
    <string name="review_title">Day review</string>
    <plurals name="review_remaining">
        <item quantity="one">%1$d left to seal</item>
        <item quantity="other">%1$d left to seal</item>
    </plurals>
    <string name="review_done">Done</string>
    <string name="review_skip">Didn\'t do it</string>
    <string name="review_leave">Leave it</string>
    <string name="review_within_limit">Within limit</string>
    <string name="review_clean">Clean day</string>
    <string name="review_seal_day">Seal the day</string>
    <string name="review_sealed_title">Day sealed</string>
    <string name="review_perfect_title">Perfect day!</string>
    <string name="review_points_today" translatable="false">+%1$d pts</string>
    <plurals name="review_streaks_advanced">
        <item quantity="one">%1$d streak advanced</item>
        <item quantity="other">%1$d streaks advanced</item>
    </plurals>
    <!-- ReviewRowCard's RowNameHeader: name + StreakChip merge into one TalkBack stop — this
         overrides the merge so it names the flame chip's meaning instead of just concatenating the
         name and the bare count (same mechanism as stats_streak_card_cd). -->
    <string name="review_row_streak_cd">%1$s, streak %2$d</string>
    <string name="review_until_tomorrow">See you tomorrow</string>
    <string name="review_new_badges">New badges</string>
    <string name="today_close_day">Close the day</string>
    <string name="settings_celebration_label">Perfect-day celebration</string>
    <string name="settings_celebration_hint">A nudge from Habi when you close a perfect day outside the app. Inside, it\'s always celebrated.</string>
</resources>
