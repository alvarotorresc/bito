<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="channel_reminders">Reminders</string>
    <string name="channel_celebrations">Celebrations</string>

    <!--
        GLOBAL reminder, in Habi's voice (ReminderVoice) — one title + one body per personality
        and time-of-day flavor. Registers per docs/07-textos-personalidades.md; EN is the same
        native voice, not a translation.
        Titles: %1$s = the user's name.
        Bodies: plurals keyed by the pending count — %1$d = pending count, %2$s = up to three
        pending names joined, %3$d = done today, %4$d = total today. Not every flavor uses every
        placeholder; the render call always passes all four.
    -->
    <string name="notif_reminder_title_sargento_morning">Up and at it, %1$s. There\'s work today.</string>
    <string name="notif_reminder_title_sargento_morning_sin_nombre">Up and at it. There\'s work today.</string>
    <string name="notif_reminder_title_sargento_afternoon">Halfway through, %1$s. Don\'t ease up.</string>
    <string name="notif_reminder_title_sargento_afternoon_sin_nombre">Halfway through. Don\'t ease up.</string>
    <string name="notif_reminder_title_sargento_evening">Last call, %1$s.</string>
    <string name="notif_reminder_title_sargento_evening_sin_nombre">Last call.</string>
    <string name="notif_reminder_title_cheerleader_morning">Morning, %1$s! Today looks good.</string>
    <string name="notif_reminder_title_cheerleader_morning_sin_nombre">Morning! Today looks good.</string>
    <string name="notif_reminder_title_cheerleader_afternoon">Still going, %1$s! The afternoon is ours.</string>
    <string name="notif_reminder_title_cheerleader_afternoon_sin_nombre">Still going! The afternoon is ours.</string>
    <string name="notif_reminder_title_cheerleader_evening">One last push, %1$s!</string>
    <string name="notif_reminder_title_cheerleader_evening_sin_nombre">One last push!</string>
    <string name="notif_reminder_title_neutra_morning">Good morning, %1$s. Your day, at a glance.</string>
    <string name="notif_reminder_title_neutra_morning_sin_nombre">Good morning. Your day, at a glance.</string>
    <string name="notif_reminder_title_neutra_afternoon">Mid-afternoon, %1$s. Here\'s where we are.</string>
    <string name="notif_reminder_title_neutra_afternoon_sin_nombre">Mid-afternoon. Here\'s where we are.</string>
    <string name="notif_reminder_title_neutra_evening">The day\'s winding down, %1$s.</string>
    <string name="notif_reminder_title_neutra_evening_sin_nombre">The day\'s winding down.</string>

    <plurals name="notif_reminder_body_sargento_morning">
        <item quantity="one">One target today: %2$s. Go get it.</item>
        <item quantity="other">%1$d habits ahead: %2$s. Start strong.</item>
    </plurals>
    <plurals name="notif_reminder_body_sargento_afternoon">
        <item quantity="one">%3$d of %4$d down. One left: %2$s. Finish it.</item>
        <item quantity="other">%3$d of %4$d down. %1$d left: %2$s. No excuses.</item>
    </plurals>
    <plurals name="notif_reminder_body_sargento_evening">
        <item quantity="one">One left to close: %2$s. The day won\'t close itself.</item>
        <item quantity="other">%1$d left to close: %2$s. The day won\'t close itself.</item>
    </plurals>
    <plurals name="notif_reminder_body_cheerleader_morning">
        <item quantity="one">Just one today: %2$s. What a way to start!</item>
        <item quantity="other">We\'ve got %1$d today: %2$s. The first one sets the pace!</item>
    </plurals>
    <plurals name="notif_reminder_body_cheerleader_afternoon">
        <item quantity="one">%3$d of %4$d, and only %2$s to go. We\'ve got this!</item>
        <item quantity="other">%3$d of %4$d so far. %1$d to go: %2$s. Keep it rolling!</item>
    </plurals>
    <plurals name="notif_reminder_body_cheerleader_evening">
        <item quantity="one">Only %2$s left. Then the day is done!</item>
        <item quantity="other">%1$d left: %2$s. The day\'s final flourish!</item>
    </plurals>
    <plurals name="notif_reminder_body_neutra_morning">
        <item quantity="one">Today: %2$s. Starting is enough.</item>
        <item quantity="other">Today: %1$d habits. %2$s. One at a time.</item>
    </plurals>
    <plurals name="notif_reminder_body_neutra_afternoon">
        <item quantity="one">%3$d of %4$d done. One left: %2$s.</item>
        <item quantity="other">%3$d of %4$d done. %1$d left: %2$s.</item>
    </plurals>
    <plurals name="notif_reminder_body_neutra_evening">
        <item quantity="one">One left to close: %2$s. There\'s still time.</item>
        <item quantity="other">%1$d left to close: %2$s. There\'s still time.</item>
    </plurals>

    <!-- Per-habit reminder: the habit's own name is the title, no personality copy (yet). -->
    <string name="notif_reminder_single_title" translatable="false">%1$s</string>
    <string name="notif_reminder_single_body">Still open today</string>
    <string name="notif_action_done">Done</string>
    <string name="notif_action_add" translatable="false">+%1$d</string>
    <string name="notif_target_done">Done: %1$s</string>
    <string name="notif_target_add" translatable="false">+%1$d %2$s · %3$d/%4$d</string>


    <string name="notif_perfect_day_title">Perfect day</string>


    <!--
        Noon TASKS notice, in Habi's voice. Titles: %1$s = the user's name, %2$d = how many tasks. The body itself is
        the named titles joined by the caller, not a resource — this plural is only the "and N
        more" tail, appended when some notices are left unnamed. No personality variation.
    -->
    <plurals name="notif_tasks_title_sargento">
        <item quantity="one">%1$s, something\'s waiting.</item>
        <item quantity="other">%1$s, %2$d things are waiting.</item>
    </plurals>
    <plurals name="notif_tasks_title_sargento_sin_nombre">
        <item quantity="one">Something\'s waiting.</item>
        <item quantity="other">%2$d things are waiting.</item>
    </plurals>
    <plurals name="notif_tasks_title_cheerleader">
        <item quantity="one">Shall we, %1$s?</item>
        <item quantity="other">Shall we, %1$s? There are %2$d.</item>
    </plurals>
    <plurals name="notif_tasks_title_cheerleader_sin_nombre">
        <item quantity="one">Shall we?</item>
        <item quantity="other">Shall we? There are %2$d.</item>
    </plurals>
    <plurals name="notif_tasks_title_neutra">
        <item quantity="one">You have a task, %1$s.</item>
        <item quantity="other">You have %2$d tasks, %1$s.</item>
    </plurals>
    <plurals name="notif_tasks_title_neutra_sin_nombre">
        <item quantity="one">You have a task.</item>
        <item quantity="other">You have %2$d tasks.</item>
    </plurals>
    <!-- notif_breathing_* — M11, the optional daily breathing reminder. %1$s = user name. -->
    <string name="notif_breathing_title_sargento">%1$s, two minutes.</string>
    <string name="notif_breathing_title_sargento_sin_nombre">Two minutes.</string>
    <string name="notif_breathing_title_cheerleader">Shall we breathe for a bit, %1$s?</string>
    <string name="notif_breathing_title_cheerleader_sin_nombre">Shall we breathe for a bit?</string>
    <string name="notif_breathing_title_neutra">Time to breathe, %1$s.</string>
    <string name="notif_breathing_title_neutra_sin_nombre">Time to breathe.</string>
    <string name="notif_breathing_body_sargento">Breathe with me. Then carry on.</string>
    <string name="notif_breathing_body_cheerleader">I\'ll be waiting with my eyes closed.</string>
    <string name="notif_breathing_body_neutra">Whenever you can.</string>
    <plurals name="notif_tasks_more">
        <item quantity="one">and %1$d more</item>
        <item quantity="other">and %1$d more</item>
    </plurals>
</resources>
