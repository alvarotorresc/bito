    <string name="habi_avatar_cd">Habi</string>
    <!-- HabiAvatar's real TalkBack description: "%1$s" = habi_avatar_cd, "%2$s" = mood_label_*
         below — deliberately mood-only, no personality copy (see HabiVoice.moodLabelRes kdoc).
         mood_label_* wording is T7b draft copy, same as habi_bubble_*/habi_home_*/etc. below —
         pending architect validation (docs/07). -->
    <string name="habi_avatar_cd_mood">%1$s, %2$s</string>
    <string name="mood_label_radiant">feeling great</string>
    <string name="mood_label_normal">doing okay</string>
    <string name="mood_label_wilted">feeling low</string>
    <string name="mood_label_dramatic">having a hard time</string>
    <string name="habi_balance_points">bitos</string>

    <!--
        Habi's personality-voiced texts (T13/T8, HabiVoice) — M9 draft copy — pending architect
        validation (docs/07). Six contexts:
        habi_bubble_* — Stats commentator, mood-only (no name).
        habi_home_*   — Habi screen's own bubble, playful home-context, %1$s = user name.
        freezer_info_* — the freezers ⓘ sheet body, %1$s = user name. The price is deliberately
        never baked in here — it lives in EconomyConfig.
        habi_perfect_* — the E2 perfect-day in-app sheet, %1$s = user name.
        habi_perfect_notif_* — the perfect-day notification body, %1$s = user name.
        habi_badge_* — the badge-unlocked sheet, %1$s = user name, %2$s = badge name.
    -->
    <string name="habi_bubble_sargento_radiant">A flawless week. Not one slip. That\'s the standard.</string>
    <string name="habi_bubble_sargento_normal">Acceptable. We both know you\'ve got more.</string>
    <string name="habi_bubble_sargento_wilted">Rough week. Don\'t argue with it. Fix it.</string>
    <string name="habi_bubble_sargento_dramatic">Three days without showing up? Don\'t you dare give up now.</string>
    <string name="habi_bubble_cheerleader_radiant">What a week! Honestly, frame this one.</string>
    <string name="habi_bubble_cheerleader_normal">Good week. And the next one? Even better!</string>
    <string name="habi_bubble_cheerleader_wilted">A tough week — I won\'t sugarcoat it. Tomorrow we start a new one, you and me.</string>
    <string name="habi_bubble_cheerleader_dramatic">Three days without you! I missed you. Come back — it\'s not the same around here.</string>
    <string name="habi_bubble_neutra_radiant">A very solid week: over 80 percent done.</string>
    <string name="habi_bubble_neutra_normal">A steady week. Keep going.</string>
    <string name="habi_bubble_neutra_wilted">A slow week: under half done. One habit today is enough to restart.</string>
    <string name="habi_bubble_neutra_dramatic">Three days with no entries. Whenever you\'re ready, I\'m here.</string>

    <string name="habi_home_sargento_radiant">Peak form, %1$s. Inspection: passed.</string>
    <string name="habi_home_sargento_radiant_sin_nombre">Peak form. Inspection: passed.</string>
    <string name="habi_home_sargento_normal">What have you got for me today, %1$s?</string>
    <string name="habi_home_sargento_normal_sin_nombre">What have you got for me today?</string>
    <string name="habi_home_sargento_wilted">See this face, %1$s? Habits fix it. Cuddles don\'t.</string>
    <string name="habi_home_sargento_wilted_sin_nombre">See this face? Habits fix it. Cuddles don\'t.</string>
    <string name="habi_home_sargento_dramatic">Where were you, %1$s? Doesn\'t matter. You\'re here now — get to work.</string>
    <string name="habi_home_sargento_dramatic_sin_nombre">Where were you? Doesn\'t matter. You\'re here now, so get to work.</string>
    <string name="habi_home_cheerleader_radiant">Look at us, %1$s — glowing! And that\'s all your doing.</string>
    <string name="habi_home_cheerleader_radiant_sin_nombre">Look at us, glowing! And that\'s all your doing.</string>
    <string name="habi_home_cheerleader_normal">Hi, %1$s! I was hoping you\'d drop by.</string>
    <string name="habi_home_cheerleader_normal_sin_nombre">Hi! I was hoping you\'d drop by.</string>
    <string name="habi_home_cheerleader_wilted">%1$s… it\'s been rough, but we\'re in this together, okay?</string>
    <string name="habi_home_cheerleader_wilted_sin_nombre">It\'s been rough, but we\'re in this together, okay?</string>
    <string name="habi_home_cheerleader_dramatic">%1$s, it\'s been ages! I saved your spot. Come here.</string>
    <string name="habi_home_cheerleader_dramatic_sin_nombre">It\'s been ages! I saved your spot. Come here.</string>
    <string name="habi_home_neutra_radiant">Good pace this week, %1$s.</string>
    <string name="habi_home_neutra_radiant_sin_nombre">Good pace this week.</string>
    <string name="habi_home_neutra_normal">Hi, %1$s. All in order.</string>
    <string name="habi_home_neutra_normal_sin_nombre">Hi. All in order.</string>
    <string name="habi_home_neutra_wilted">%1$s, time to pick things back up. One habit will do.</string>
    <string name="habi_home_neutra_wilted_sin_nombre">Time to pick things back up. One habit will do.</string>
    <string name="habi_home_neutra_dramatic">It\'s been a few days, %1$s. Good to see you.</string>
    <string name="habi_home_neutra_dramatic_sin_nombre">It\'s been a few days. Good to see you.</string>


    <string name="freezer_info_sargento">One freezer, one habit, one day. See a missed day on the calendar? Tap it and use it. They\'re bought in the store. Don\'t waste them, %1$s.</string>
    <string name="freezer_info_sargento_sin_nombre">One freezer, one habit, one day. See a missed day on the calendar? Tap it and use it. They\'re bought in the store. Don\'t waste them.</string>
    <string name="freezer_info_cheerleader">A freezer saves your streak if you miss ONE day on ONE habit! Tap the missed day on the calendar, hit \"Use a freezer\" and done. They\'re waiting in the store. If I were you, I\'d always keep one around, %1$s.</string>
    <string name="freezer_info_cheerleader_sin_nombre">A freezer saves your streak if you miss ONE day on ONE habit! Tap the missed day on the calendar, hit \"Use a freezer\" and done. They\'re waiting in the store. If I were you, I\'d always keep one around.</string>
    <string name="freezer_info_neutra">A freezer protects a failed day: the streak skips it instead of breaking. To use one, tap a missed day on the calendar and pick \"Use a freezer\". They\'re bought in Habi\'s store, %1$s.</string>
    <string name="freezer_info_neutra_sin_nombre">A freezer protects a failed day: the streak skips it instead of breaking. To use one, tap a missed day on the calendar and pick \"Use a freezer\". They\'re bought in Habi\'s store.</string>




    <string name="habi_perfect_sargento">Perfect day, %1$s. That\'s how it\'s done. Don\'t get comfortable.</string>
    <string name="habi_perfect_sargento_sin_nombre">Perfect day. That\'s how it\'s done. Don\'t get comfortable.</string>
    <string name="habi_perfect_cheerleader">A perfect day, %1$s! Every single thing, done. I could burst.</string>
    <string name="habi_perfect_cheerleader_sin_nombre">A perfect day! Every single thing, done. I could burst.</string>
    <string name="habi_perfect_neutra">Perfect day, %1$s. Everything required, done.</string>
    <string name="habi_perfect_neutra_sin_nombre">Perfect day. Everything required, done.</string>

    <string name="habi_perfect_notif_sargento">Perfect day, %1$s. Flawless. Same again tomorrow.</string>
    <string name="habi_perfect_notif_sargento_sin_nombre">Perfect day. Flawless. Same again tomorrow.</string>
    <string name="habi_perfect_notif_cheerleader">Perfect day, %1$s! You didn\'t miss a thing.</string>
    <string name="habi_perfect_notif_cheerleader_sin_nombre">Perfect day! You didn\'t miss a thing.</string>
    <string name="habi_perfect_notif_neutra">Perfect day, %1$s. Nothing was left undone today.</string>
    <string name="habi_perfect_notif_neutra_sin_nombre">Perfect day. Nothing was left undone today.</string>

    <string name="habi_badge_sargento">%2$s. Earned, %1$s. I never doubted it.</string>
    <string name="habi_badge_sargento_sin_nombre">%2$s. Earned. I never doubted it.</string>
    <string name="habi_badge_cheerleader">%2$s! I knew you had it in you, %1$s.</string>
