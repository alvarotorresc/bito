<resources>
    <string name="habi_avatar_cd">Habi</string>
    <!-- Descripción real de HabiAvatar para TalkBack: "%1$s" = habi_avatar_cd, "%2$s" = mood_label_*
         de abajo — solo por ánimo a propósito, sin copy de personalidad (ver kdoc de moodLabelRes).
         mood_label_* es texto solo de TalkBack y queda FUERA a propósito de las tablas de voz
         de docs/07 §2 (sin personalidad, sin nombre), así que la validación de M10 ni lo cubre
         ni lo deja pendiente — ver la nota de cobertura al final de docs/07 §2. -->
    <string name="habi_avatar_cd_mood">%1$s, %2$s</string>
    <string name="mood_label_radiant">de maravilla</string>
    <string name="mood_label_normal">bien</string>
    <string name="mood_label_wilted">con el ánimo bajo</string>
    <string name="mood_label_dramatic">pasándolo mal</string>
    <string name="habi_balance_points">puntos</string>
    <string name="habi_name_fallback">campeón</string>

    <!--
        Textos con voz de personalidad de Habi (T13/T8, HabiVoice) — copy VALIDADO en M10
        contra docs/07 (candidata B: compañera que va contigo, no espejo que comenta). Diez
        contextos abajo, más otros dos más adelante en este fichero
        (habi_day_waiting_*/habi_day_asleep_* y habi_eye_first_*/habi_eye_second_*, cada uno con
        su propio bloque de comentario donde se define):
        habi_bubble_* — comentarista de Stats, solo por ánimo (sin nombre).
        habi_home_*   — globo propio de la pantalla Habi, tono jugador de hogar, %1$s = nombre.
        habi_greeting_* — esquina de Habi en Hoy, corto, %1$s = nombre (lo consume T14). Se
        conserva entero este hito (spec §12.1) — la esquina sigue abriendo con un saludo corto.
        freezer_info_* — cuerpo de la hoja ⓘ de congeladores, %1$s = nombre. El precio nunca se
        hardcodea aquí a propósito — vive en EconomyConfig.
        habi_review_* — mini-globo del repaso E1, %1$s = nombre.
        habi_review_clear_* — estado celebratorio de repaso vacío E1, %1$s = nombre.
        habi_sealed_* — hoja de día sellado E2 normal, %1$s = nombre.
        habi_perfect_* — hoja in-app de día perfecto E2, %1$s = nombre.
        habi_perfect_notif_* — cuerpo de la notificación de día perfecto, %1$s = nombre.
        habi_badge_* — hoja de logro desbloqueado, %1$s = nombre, %2$s = nombre del badge. Habla
        en todos los badges salvo streak-7, donde habla habi_eye_second_* en su lugar (un solo
        globo, no dos).
    -->
    <string name="habi_bubble_sargento_radiant">Semana impecable. Ni un pero. Así se trabaja.</string>
    <string name="habi_bubble_sargento_normal">Aceptable. Tú y yo sabemos que puedes más.</string>
    <string name="habi_bubble_sargento_wilted">Mala semana. No la discutas: corrígela.</string>
    <string name="habi_bubble_sargento_dramatic">¿Tres días sin aparecer? Ni se te ocurra rendirte ahora.</string>
    <string name="habi_bubble_cheerleader_radiant">¡Menuda semana! De las que se enmarcan.</string>
    <string name="habi_bubble_cheerleader_normal">Buena semana. ¡Y la que viene, mejor!</string>
    <string name="habi_bubble_cheerleader_wilted">Semana dura, no te lo voy a negar. Mañana empezamos otra, tú y yo.</string>
    <string name="habi_bubble_cheerleader_dramatic">¡Tres días sin verte! Te he echado de menos. Vuelve, que esto sin ti no es lo mismo.</string>
    <string name="habi_bubble_neutra_radiant">Semana muy sólida: más del 80 por ciento cumplido.</string>
    <string name="habi_bubble_neutra_normal">Semana dentro de lo normal. Sigue así.</string>
    <string name="habi_bubble_neutra_wilted">Semana floja: menos de la mitad cumplido. Un hábito hoy basta para arrancar.</string>
    <string name="habi_bubble_neutra_dramatic">Tres días sin registros. Cuando quieras, aquí sigo.</string>

    <string name="habi_home_sargento_radiant">En plena forma, %1$s. Así da gusto pasar revista.</string>
    <string name="habi_home_sargento_normal">¿Me has traído algo, %1$s?</string>
    <string name="habi_home_sargento_wilted">¿Ves esta cara, %1$s? Se arregla con hábitos, no con mimos.</string>
    <string name="habi_home_sargento_dramatic">¿Dónde estabas, %1$s? Da igual. Ya estás aquí: a trabajar.</string>
    <string name="habi_home_cheerleader_radiant">¡Mírate, %1$s! Estamos radiantes. Y eso es cosa tuya.</string>
    <string name="habi_home_cheerleader_normal">¡Hola, %1$s! Qué ganas tenía de verte.</string>
    <string name="habi_home_cheerleader_wilted">%1$s… ha sido duro, pero seguimos en esto, ¿vale?</string>
    <string name="habi_home_cheerleader_dramatic">¡%1$s, cuánto tiempo! Te he guardado el sitio. Ven aquí.</string>
    <string name="habi_home_neutra_radiant">Buen ritmo esta semana, %1$s.</string>
    <string name="habi_home_neutra_normal">Hola, %1$s. Todo en orden.</string>
    <string name="habi_home_neutra_wilted">%1$s, va siendo hora de retomar. Con un hábito basta.</string>
    <string name="habi_home_neutra_dramatic">Hace días que no te veía, %1$s. Me alegra que estés aquí.</string>

    <string name="habi_greeting_sargento_radiant">Buen nivel, %1$s. Mantenlo.</string>
    <string name="habi_greeting_sargento_normal">En marcha, %1$s.</string>
    <string name="habi_greeting_sargento_wilted">%1$s, esos hábitos no se hacen solos.</string>
    <string name="habi_greeting_sargento_dramatic">Te estaba esperando, %1$s. Empieza por uno.</string>
    <string name="habi_greeting_cheerleader_radiant">¡Vas que vuelas, %1$s!</string>
    <string name="habi_greeting_cheerleader_normal">Hola, %1$s. ¡A por hoy!</string>
    <string name="habi_greeting_cheerleader_wilted">Ánimo, %1$s. Hoy remontamos.</string>
    <string name="habi_greeting_cheerleader_dramatic">¡Te echaba de menos, %1$s!</string>
    <string name="habi_greeting_neutra_radiant">Vamos bien, %1$s.</string>
    <string name="habi_greeting_neutra_normal">Hola, %1$s.</string>
    <string name="habi_greeting_neutra_wilted">%1$s, hoy es un buen día para retomar.</string>
    <string name="habi_greeting_neutra_dramatic">%1$s, qué bien verte de vuelta.</string>

    <string name="freezer_info_sargento">Un congelador, un hábito, un día. ¿Ves un día en rojo en el calendario? Tócalo y úsalo. Se compran en la tienda. No los malgastes, %1$s.</string>
    <string name="freezer_info_cheerleader">¡Un congelador te salva la racha si fallas UN día en UN hábito! Toca el día en rojo del calendario, dale a «Usar congelador» y listo. Los tienes en la tienda. Yo que tú tendría siempre uno a mano, %1$s.</string>
    <string name="freezer_info_neutra">Un congelador protege un día fallado: la racha lo salta en vez de romperse. Para usarlo, toca un día en rojo en el calendario y elige «Usar congelador». Se compran en la tienda de Habi, %1$s.</string>

    <string name="habi_review_sargento">Cerremos el día, %1$s. Sin excusas.</string>
    <string name="habi_review_cheerleader">¡Hora de cerrar el día, %1$s! Lo que falte, lo hacemos ya.</string>
    <string name="habi_review_neutra">Repaso del día, %1$s. Solo lo que queda.</string>

    <string name="habi_review_clear_sargento">Nada pendiente. Hoy no tengo quejas, %1$s.</string>
    <string name="habi_review_clear_cheerleader">¡%1$s, lo tienes todo hecho! Sella y a descansar.</string>
    <string name="habi_review_clear_neutra">Nada pendiente, %1$s. Puedes sellar el día.</string>

    <string name="habi_sealed_sargento">Cerrado, %1$s. Mañana, más.</string>
    <string name="habi_sealed_cheerleader">¡Otro día nuestro, %1$s! Qué gusto.</string>
    <string name="habi_sealed_neutra">Ya está, %1$s. Descansa.</string>

    <string name="habi_perfect_sargento">Día perfecto, %1$s. Así se hace. No te relajes.</string>
    <string name="habi_perfect_cheerleader">¡Día perfecto, %1$s! Todo hecho, todo. Estoy que no quepo en mí.</string>
    <string name="habi_perfect_neutra">Día perfecto, %1$s. Todo lo exigible, cumplido.</string>

    <string name="habi_perfect_notif_sargento">Día perfecto, %1$s. Impecable. Mañana igual.</string>
    <string name="habi_perfect_notif_cheerleader">¡Día perfecto, %1$s! Hoy no se te escapó nada.</string>
    <string name="habi_perfect_notif_neutra">Día perfecto, %1$s. Que conste.</string>

    <string name="habi_badge_sargento">%2$s. Te lo has ganado, %1$s. Era cuestión de tiempo.</string>
    <string name="habi_badge_cheerleader">¡%2$s! Sabía que lo conseguirías, %1$s.</string>
    <string name="habi_badge_neutra">Logro desbloqueado: %2$s. Bien hecho.</string>

