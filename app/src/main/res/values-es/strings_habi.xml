    <!-- Su día, con cuentagotas (biblia §7.2): DOS líneas, y solo en la pantalla Habi. Sin
         placeholders — el sitio donde se pintan no las formatea. Copy VALIDADO en M10 contra
         docs/07 §7 (la de esperar el cierre suena una vez por día lógico). -->
    <string name="habi_day_waiting_sargento">Mi día está hecho. Cierra el tuyo cuando toque.</string>
    <string name="habi_day_waiting_cheerleader">Lo mío ya está hecho. ¡Me quedo contigo hasta cerrar!</string>
    <string name="habi_day_waiting_neutra">He terminado mi día. Aquí me quedo, esperando el tuyo.</string>
    <string name="habi_day_asleep_sargento">Me duermo. Tú también deberías.</string>
    <string name="habi_day_asleep_cheerleader">Me duermo feliz. ¡Hasta mañana!</string>
    <string name="habi_day_asleep_neutra">Día cerrado. Buenas noches.</string>

    <!-- El ritual del ojo (biblia §4). NO son globos del gesto: el rito se pinta en silencio y sin
         texto, y estas líneas son el texto de la SUPERFICIE que lo acompaña — la página 7g y la
         hoja del logro. %1$s = nombre. Copy VALIDADO en M10 contra docs/07 §6. -->
    <string name="habi_eye_first_sargento">Un ojo, %1$s. El otro se gana.</string>
    <string name="habi_eye_first_cheerleader">¡Ya te veo, %1$s! Con un ojo, pero te veo.</string>
    <string name="habi_eye_first_neutra">Ya te distingo, %1$s. Con un ojo basta para empezar.</string>
    <string name="habi_eye_second_sargento">Te has ganado el otro ojo, %1$s. Ahora te miro de frente.</string>
    <string name="habi_eye_second_cheerleader">¡Los dos ojos, %1$s! Ahora te veo de verdad.</string>
    <string name="habi_eye_second_neutra">Ya te miro con los dos, %1$s. Siete días seguidos.</string>
