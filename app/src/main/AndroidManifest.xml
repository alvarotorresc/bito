<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Bito no declara el permiso INTERNET a propósito: la garantía "tus datos
         jamás salen del móvil" es verificable por cualquiera en este manifest. -->

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- lint la marca como ProtectedPermissions bajo compileSdk 35; es de uso
         normal para recordatorios de usuario, no de sistema. -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Feedback de registro (Ajustes › Al registrar): vibración controlada por el switch
         de la app, no por el ajuste global de vibración al tacto. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".BitoApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.Bito">

        <!-- AppCompatDelegate.setApplicationLocales persists nothing below API 33 unless the app
             opts into AppCompat's own on-disk storage — this service is never started, it exists
             only for its meta-data, which AppCompat's own ActivityLifecycleCallbacks reads at
             startup on API<33 to auto-restore the locale it last applied. See AppLocale.kt's KDoc
             for the full reconciliation story with Settings.languageTag (the DataStore field this
             cache mirrors). -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.widget.TodayWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.Bito">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver android:name=".ui.widget.TodayWidgetReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>
        <activity
            android:name=".ui.widget.SingleHabitConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.Bito">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <receiver android:name=".ui.widget.SingleHabitWidgetReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/single_habit_widget_info" />
        </receiver>
        <receiver android:name=".ui.widget.WidgetMidnightReceiver" android:exported="false" />
        <receiver android:name=".ui.notifications.ReminderReceiver" android:exported="false" />
        <receiver android:name=".ui.notifications.QuickActionReceiver" android:exported="false" />
        <receiver android:name=".ui.notifications.BootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <receiver android:name=".ui.notifications.ExactAlarmReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
